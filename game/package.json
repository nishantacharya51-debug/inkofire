{
  "name": "apex-island",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Apex Island - original browser battle royale shooter (Three.js + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "simulate": "node --experimental-strip-types scripts/simulate.ts",
    "qa": "node --experimental-strip-types scripts/qa.ts"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.4",
    "@types/three": "^0.169.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.48.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
